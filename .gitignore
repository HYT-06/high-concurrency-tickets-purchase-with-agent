# start-all.sh 产生的运行日志与 pid 文件
logs/

# Maven 构建产物
# monitor-agent 原先没有自己的 .gitignore，导致 target/ 下的 class 文件与
# application.yml 副本（含 API Key）被提交进仓库，这里统一兜住。
target/
*.class

# 本地基础设施运行时目录（MySQL 从库数据、Redis 哨兵配置等），不入版本库
mysql-slave-data/
redis-sentinel/

# IDE
.idea/
*.iml
.vscode/

# 本地密钥配置（API Key / JWT 密钥等），绝不能进版本库
# 各模块的 application.yml 只写占位符，真实值放这里的 local 文件
application-local.yml
application-local.properties
